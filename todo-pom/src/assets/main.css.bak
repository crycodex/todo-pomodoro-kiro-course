/* iOS Design Tokens */

*,
*::before,
*::after {
  box-sizing: border-box;
}

:root {
  /* Border Radius Scale */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 22px;
  --radius-full: 9999px;

  /* Spacing Scale (8px grid) */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;

  /* Typography */
  --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
  --font-mono: "SF Mono", ui-monospace, monospace;

  /* Animation Curves */
  --ease-ios-spring: cubic-bezier(0.175, 0.885, 0.32, 1.275);
  --ease-smooth: cubic-bezier(0.2, 0.8, 0.2, 1);
  --duration-theme: 0.3s;

  /* Light Mode Colors */
  --label-primary: #000000;
  --label-secondary: #3a3a3c;
  --label-tertiary: #8e8e93;
  --label-quaternary: #c7c7cc;
  --fill-primary: #ffffff;
  --fill-secondary: #f2f2f7;
  --fill-tertiary: #e5e5ea;
  --fill-quaternary: #d1d1d6;
  --system-blue: #007aff;
  --system-red: #ff3b30;
  --system-green: #34c759;
  --system-orange: #ff9500;
  --divider: rgba(0, 0, 0, 0.08);
  --border: rgba(0, 0, 0, 0.08);
  --bg-app: var(--fill-secondary);
  --bg-grouped: var(--fill-primary);
  --bg-card: rgba(255, 255, 255, 0.72);
  --bg-sheet: rgba(255, 255, 255, 0.85);

  /* Legacy colors for backwards compatibility */
  --color-bg: var(--bg-app);
  --color-surface: var(--fill-primary);
  --color-text: var(--label-primary);
  --color-text-muted: var(--label-secondary);
  --color-border: var(--border);
  --color-hover: var(--fill-tertiary);
  --color-inverse: var(--label-primary);
  --color-inverse-text: var(--fill-primary);
  --header-height: var(--space-8);
  --tap: 44px;
  --font: var(--font-sans);
  --mono: var(--font-mono);
}

:root[data-theme="dark"] {
  /* Dark Mode Colors */
  --label-primary: #ffffff;
  --label-secondary: #ebebf5;
  --label-tertiary: #8e8e93;
  --label-quaternary: #a0a0a4;
  --fill-primary: #1c1c1e;
  --fill-secondary: #2c2c2e;
  --fill-tertiary: #3a3a3c;
  --fill-quaternary: #505053;
  --system-blue: #0a84ff;
  --system-red: #ff453a;
  --system-green: #30d158;
  --system-orange: #ff9500;
  --divider: rgba(255, 255, 255, 0.08);
  --border: rgba(255, 255, 255, 0.08);
  --bg-app: #000000;
  --bg-grouped: var(--fill-primary);
  --bg-card: rgba(28, 28, 30, 0.72);
  --bg-sheet: rgba(28, 28, 30, 0.85);

  /* Legacy colors for backwards compatibility */
  --color-bg: var(--bg-app);
  --color-surface: var(--fill-primary);
  --color-text: var(--label-primary);
  --color-text-muted: var(--label-secondary);
  --color-border: var(--border);
  --color-hover: var(--fill-tertiary);
  --color-inverse: var(--label-primary);
  --color-inverse-text: var(--fill-primary);
}

/* Transitions */
* {
  transition: background-color var(--duration-theme) var(--ease-smooth),
              color var(--duration-theme) var(--ease-smooth),
              border-color var(--duration-theme) var(--ease-smooth);
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* Backdrop-filter fallback */
@supports not (backdrop-filter: blur(20px)) {
  .glass,
  .card,
  .sheet {
    background: var(--bg-grouped);
  }
}

/* Base Styles */
html,
body {
  margin: 0;
  min-height: 100%;
}

body {
  font-family: var(--font-sans);
  background: var(--bg-app);
  color: var(--label-primary);
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
  transition: background-color var(--duration-theme) var(--ease-smooth),
              color var(--duration-theme) var(--ease-smooth);
}

button,
input {
  font-family: inherit;
  color: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible {
  outline: 2px solid var(--system-blue);
  outline-offset: 2px;
}

#app {
  min-height: 100svh;
}

.app-shell {
  min-height: 100svh;
  display: flex;
  flex-direction: column;
}

.app-banner {
  margin: 0 var(--space-4);
  padding: calc(var(--space-2) / 2) var(--space-3);
  background: var(--label-primary);
  color: var(--fill-primary);
  font-size: 0.9rem;
  border-radius: var(--radius-sm);
}

.app-layout {
  flex: 1;
  width: min(1080px, 100%);
  margin: 0 auto;
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.tasks-column {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  min-width: 0;
}

@media (min-width: 768px) {
  .app-layout {
    padding: var(--space-6);
  }

  .app-layout.with-timer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    align-items: start;
    gap: var(--space-7);
  }
}
